#ifndef CONFIG_SECRET_H
#define CONFIG_SECRET_H

// ============================================================================
// CẤU HÌNH BẢO MẬT XE THẬT (HARDWARE SECRETS)
// HƯỚNG DẪN:
// 1. Sao chép file này thành "config_secret.h" trong cùng thư mục include/
// 2. Điền mã xe thật, mã PIN và Wi-Fi của riêng bạn
// 3. File "config_secret.h" đã được cấu hình trong .gitignore, KHÔNG BAO GIỜ bị lộ trên Git!
// ============================================================================

#define VEHICLE_CODE "YOUR_CAR_CODE"       // Mã xe thật bí mật của bạn
#define VEHICLE_PIN  "YOUR_PIN_CODE"       // Mã PIN bảo mật khi liên kết trên Web

#define SECRET_WIFI_SSID "YOUR_WIFI_SSID"  // Tên Wi-Fi của bạn
#define SECRET_WIFI_PASS "YOUR_WIFI_PASS"  // Mật khẩu Wi-Fi của bạn

#endif
